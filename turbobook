local soundOriginal = {}
Features.Mudo = function(state)
    pcall(function()
        if state then
            soundOriginal = {}
            for _, s in ipairs(workspace:GetDescendants()) do
                if s:IsA("Sound") then
                    soundOriginal[s] = s.Volume
                    s.Volume = 0
                end
            end
        else
            for s, vol in pairs(soundOriginal) do
                if s and s.Parent then s.Volume = vol end
            end
            soundOriginal = {}
        end
    end)
end

