-- ========================
-- ANTI PULO
-- ========================
local jumpOriginal = {UseJumpPower = true, JumpPower = 50, JumpHeight = 7.2}
local antiPulo = false

local function ApplyAntiPulo()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    pcall(function()
        if antiPulo then
            hum.UseJumpPower = true
            hum.JumpPower = 0
            hum.JumpHeight = 0
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        else
            hum.UseJumpPower = jumpOriginal.UseJumpPower
            hum.JumpPower = jumpOriginal.JumpPower
            hum.JumpHeight = jumpOriginal.JumpHeight
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        end
    end)
end

Features.AntiPulo = function(state)
    if state and not antiPulo then
        -- salva valores originais antes de travar
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            jumpOriginal.UseJumpPower = hum.UseJumpPower
            jumpOriginal.JumpPower = hum.JumpPower > 0 and hum.JumpPower or 50
            jumpOriginal.JumpHeight = hum.JumpHeight > 0 and hum.JumpHeight or 7.2
        end
    end
    antiPulo = state
    ApplyAntiPulo()
end

table.insert(Connections, LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.6)
    if antiPulo then ApplyAntiPulo() end
end))

-- Reforço: se o jogo tentar liberar o pulo, trava de novo
table.insert(Connections, UserInputService.JumpRequest:Connect(function()
    if antiPulo then
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Jump = false
            if hum.JumpPower ~= 0 then ApplyAntiPulo() end
        end
    end
end))

-- ========================
-- OTIMIZAÇÃO (efeitos / sombras / partículas)
-- ========================
local lightOriginal = nil
local postOriginal = {}
local fxOriginal = {}
local fxConn = nil

local function IsFx(obj)
    return obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke")
        or obj:IsA("Fire") or obj:IsA("Sparkles") or obj:IsA("Beam")
end

Features.Otimizar = function(state)
    pcall(function()
        if state then
            lightOriginal = {
                GlobalShadows = Lighting.GlobalShadows,
                FogEnd = Lighting.FogEnd,
                FogStart = Lighting.FogStart,
                Quality = settings().Rendering.QualityLevel
            }
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            Lighting.GlobalShadows = false
            Lighting.FogEnd = 1e9

            postOriginal = {}
            for _, v in ipairs(Lighting:GetChildren()) do
                if v:IsA("PostEffect") or v:IsA("Atmosphere") then
                    postOriginal[v] = v:IsA("PostEffect") and v.Enabled or nil
                    if v:IsA("PostEffect") then v.Enabled = false end
                end
            end

            fxOriginal = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                if IsFx(obj) then
                    fxOriginal[obj] = obj.Enabled
                    obj.Enabled = false
                end
            end

            -- desliga efeitos novos que aparecerem
            fxConn = workspace.DescendantAdded:Connect(function(obj)
                if IsFx(obj) then
                    task.defer(function()
                        pcall(function()
                            fxOriginal[obj] = obj.Enabled
                            obj.Enabled = false
                        end)
                    end)
                end
            end)
        else
            if fxConn then fxConn:Disconnect() fxConn = nil end
            if lightOriginal then
                Lighting.GlobalShadows = lightOriginal.GlobalShadows
                Lighting.FogEnd = lightOriginal.FogEnd
                Lighting.FogStart = lightOriginal.FogStart
                settings().Rendering.QualityLevel = lightOriginal.Quality
            end
            for v, was in pairs(postOriginal) do
                if v and v.Parent and was ~= nil then v.Enabled = was end
            end
            for obj, was in pairs(fxOriginal) do
                if obj and obj.Parent then obj.Enabled = was end
            end
            postOriginal, fxOriginal = {}, {}
        end
    end)
end

-- ========================
-- MODO BATATA (materiais lisos, sem reflexo)
-- ========================
local matOriginal = setmetatable({}, {__mode = "k"})
local batataToken = 0

Features.Batata = function(state)
    batataToken += 1
    local myToken = batataToken

    if state then
        task.spawn(function()
            local list = workspace:GetDescendants()
            for i, obj in ipairs(list) do
                if myToken ~= batataToken or not Running then return end
                if obj:IsA("BasePart") and not obj:IsA("Terrain") then
                    local parent = obj.Parent
                    local isChar = parent and parent:FindFirstChildOfClass("Humanoid")
                    if not isChar and not matOriginal[obj] then
                        matOriginal[obj] = {obj.Material, obj.Reflectance}
                        obj.Material = Enum.Material.SmoothPlastic
                        obj.Reflectance = 0
                    end
                end
                if i % 400 == 0 then task.wait() end
            end
        end)
        pcall(function()
            local t = workspace.Terrain
            t.WaterWaveSize = 0
            t.WaterWaveSpeed = 0
            t.WaterReflectance = 0
            t.WaterTransparency = 1
        end)
    else
        task.spawn(function()
            local n = 0
            for obj, data in pairs(matOriginal) do
                if obj and obj.Parent then
                    pcall(function()
                        obj.Material = data[1]
                        obj.Reflectance = data[2]
                    end)
                end
                matOriginal[obj] = nil
                n += 1
                if n % 400 == 0 then task.wait() end
            end
        end)
        pcall(function()
            local t = workspace.Terrain
            t.WaterWaveSize = 0.15
            t.WaterWaveSpeed = 10
            t.WaterReflectance = 1
            t.WaterTransparency = 0.3
        end)
    end
end

-- ========================
-- OCULTAR ACESSÓRIOS DOS OUTROS (menos lag em servidor cheio)
-- ========================
local accOriginal = setmetatable({}, {__mode = "k"})
local accLoop = false

local function HideAccessories(hide)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            for _, acc in ipairs(plr.Character:GetChildren()) do
                if acc:IsA("Accessory") then
                    local handle = acc:FindFirstChild("Handle")
                    if handle then
                        if hide then
                            if accOriginal[handle] == nil then
                                accOriginal[handle] = handle.Transparency
                            end
                            handle.Transparency = 1
                        elseif accOriginal[handle] ~= nil then
                            handle.Transparency = accOriginal[handle]
                            accOriginal[handle] = nil
                        end
                    end
                end
            end
        end
    end
end

Features.SemAcessorios = function(state)
    accLoop = state
    if state then
        task.spawn(function()
            while accLoop and Running do
                pcall(HideAccessories, true)
                task.wait(3)
            end
        end)
    else
        pcall(HideAccessories, false)
    end
end

-- ========================
-- OCULTAR NOMES
-- ========================
local nameLoop = false
local function SetNames(hide)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                pcall(function()
                    hum.DisplayDistanceType = hide and Enum.HumanoidDisplayDistanceType.None
                        or Enum.HumanoidDisplayDistanceType.Viewer
                end)
            end
        end
    end
end

Features.SemNomes = function(state)
    nameLoop = state
    if state then
        task.spawn(function()
            while nameLoop and Running do
                SetNames(true)
                task.wait(3)
            end
        end)
    else
        SetNames(false)
    end
end

