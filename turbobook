-- contador de FPS + leitura de ping
local frames, lastTick = 0, os.clock()
table.insert(Connections, RunService.RenderStepped:Connect(function()
    frames += 1
    local now = os.clock()
    if now - lastTick >= 0.5 then
        local fps = math.floor(frames / (now - lastTick) + 0.5)
        frames, lastTick = 0, now

        fpsLabel.Text = "FPS: " .. fps
        fpsLabel.TextColor3 = fps >= 50 and C.good or (fps >= 30 and C.mid or C.bad)

        local ping = 0
        pcall(function()
            ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() + 0.5)
        end)
        pingLabel.Text = "PING: " .. ping .. " ms"
        pingLabel.TextColor3 = ping <= 80 and C.good or (ping <= 160 and C.mid or C.bad)
    end
end))

